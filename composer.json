{
    "name": "usamamuneerchaudhary/billboard",
    "description": "Ad management for Statamic: placements, weighted rotation, scheduling, targeting and privacy-friendly first-party reporting.",
    "version": "1.0",
    "type": "statamic-addon",
    "license": "proprietary",
    "keywords": [
        "statamic",
        "statamic-addon",
        "advertising",
        "ads",
        "banners",
        "sponsorship"
    ],
    "authors": [
        {
            "name": "Usama Muneer",
            "email": "hello@usamamuneer.me",
            "role": "Developer"
        }
    ],
    "support": {
        "email": "hello@usamamuneer.me"
    },
    "require": {
        "php": "^8.2",
        "statamic/cms": "^6.0"
    },
    "require-dev": {
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^10.8 || ^11.0",
        "phpunit/phpunit": "^11.5 || ^12.0",
        "usamamuneerchaudhary/laravel-slipway": "^1.8"
    },
    "autoload": {
        "psr-4": {
            "Billboard\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Billboard\\Tests\\": "tests"
        }
    },
    "scripts": {
        "test": "phpunit",
        "lint": "pint --test"
    },
    "extra": {
        "statamic": {
            "name": "Billboard",
            "description": "Ad placements, rotation, scheduling and first-party reporting for Statamic."
        },
        "laravel": {
            "providers": [
                "Billboard\\ServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pixelfusion/splitdumper": false
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
